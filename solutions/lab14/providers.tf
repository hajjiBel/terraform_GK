terraform {
  required_version = ">= 1.9"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    github = {
      source  = "integrations/github"
      version = "~> 6.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
}

# Le provider GitHub lit le jeton dans la variable d'environnement GITHUB_TOKEN :
#   export GITHUB_TOKEN="github_pat_..."   (jamais dans terraform.tfvars)
provider "github" {}
